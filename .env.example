# Rettiwt-API Base64 cookie API key (auth_token, ct0, twid).
API_KEY=

# Secret configured on Misskey webhook and sent in X-Misskey-Hook-Secret.
MISSKEY_WEBHOOK_SECRET=

# Control tag without the leading #. Case-insensitive.
REQUIRED_TAG=to_x

PORT=3000
DATABASE_PATH=/data/misskey-to-x.sqlite
MEDIA_ALLOWED_HOSTS=
RETTIWT_LOGGING=false
