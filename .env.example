# REQUIRED by current service.
# Rettiwt-API Base64 cookie key, not X Developer Portal API Key.
# Generate from auth_token, ct0 and twid. Keep secret.
API_KEY=

# Optional official X OAuth 1.0a credentials.
# The current Compose service and Rettiwt adapter do not pass/read these values.
# Filling them will not change authentication or publishing.
# X_API_KEY=
# X_API_KEY_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# Secret configured on Misskey webhook and sent in X-Misskey-Hook-Secret.
MISSKEY_WEBHOOK_SECRET=

# Control tag without the leading #. Case-insensitive.
REQUIRED_TAG=to_x

PORT=3000
DATABASE_PATH=/data/misskey-to-x.sqlite
MEDIA_ALLOWED_HOSTS=
RETTIWT_LOGGING=false
